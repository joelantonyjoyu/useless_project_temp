<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Catch the Air 💨</title>

<style>

/* =========================
   BASIC
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: "Comic Sans MS", Arial, sans-serif;

    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: linear-gradient(135deg, #72d7ff, #e8fbff);
}


/* =========================
   GAME CONTAINER
========================= */

.game-container {
    width: 950px;
    max-width: 95%;

    background: #fffef5;

    padding: 20px;

    border: 6px solid #222;
    border-radius: 25px;

    box-shadow: 10px 10px 0 #222;

    text-align: center;
}


/* =========================
   TITLE
========================= */

h1 {
    font-size: 45px;

    color: #ff5c35;

    text-shadow: 3px 3px 0 #222;

    margin-bottom: 5px;
}

.subtitle {
    font-size: 18px;

    color: #333;

    margin-bottom: 15px;
}


/* =========================
   SCORE BAR
========================= */

.info-bar {
    display: flex;

    justify-content: space-around;

    background: #ffe66d;

    border: 4px solid #222;

    border-radius: 15px;

    padding: 12px;

    margin-bottom: 15px;

    font-size: 21px;

    font-weight: bold;

    box-shadow: 5px 5px 0 #222;
}

.score {
    color: #ff5c35;
}

.timer {
    color: #0879d1;
}


/* =========================
   GAME AREA
========================= */

.game-area {
    height: 550px;

    position: relative;

    overflow: hidden;

    border: 5px solid #222;

    border-radius: 20px;

    background: linear-gradient(
        #83dcff,
        #d9f8ff
    );
}


/* =========================
   CLOUDS
========================= */

.cloud {
    position: absolute;

    font-size: 65px;

    user-select: none;

    animation:
        floatCloud 5s ease-in-out infinite;
}

.cloud1 {
    top: 20px;
    left: 30px;
}

.cloud2 {
    top: 80px;
    right: 80px;

    animation-delay: 1s;
}

@keyframes floatCloud {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(12px);
    }
}


/* =========================
   AIR
========================= */

.air {
    position: absolute;

    font-size: 42px;

    z-index: 10;

    pointer-events: none;

    filter:
        drop-shadow(2px 2px 0 white);
}


/* =========================
   BASKET
========================= */

.basket {
    position: absolute;

    width: 135px;
    height: 90px;

    background:
        repeating-linear-gradient(
            90deg,
            #d99048 0px,
            #d99048 12px,
            #b86d32 13px,
            #b86d32 16px
        );

    border: 6px solid #222;

    border-top: none;

    border-radius:
        0 0 35px 35px;

    z-index: 8;

    transition:
        left 0.05s,
        top 0.05s;
}


/* OPEN TOP */

.basket .opening {
    position: absolute;

    width: 115px;
    height: 30px;

    left: 4px;
    top: -15px;

    background: #8edfff;

    border: 6px solid #222;

    border-radius: 50%;

    z-index: 10;
}


/* BASKET HANDLE */

.basket .handle {
    position: absolute;

    width: 85px;
    height: 70px;

    left: 19px;
    top: -70px;

    border: 6px solid #222;

    border-bottom: none;

    border-radius:
        50px 50px 0 0;

    z-index: 5;
}


/* =========================
   FUNNY IMAGE
========================= */

.funny-image {
    display: none;

    position: absolute;

    inset: 0;

    background: rgba(255, 255, 255, 0.95);

    z-index: 100;

    justify-content: center;

    align-items: center;

    flex-direction: column;
}

.funny-image img {
    max-width: 80%;
    max-height: 80%;

    border: 6px solid #222;

    border-radius: 20px;

    box-shadow: 8px 8px 0 #222;
}


/* =========================
   COMIC TEXT
========================= */

.comic-text {
    position: absolute;

    font-size: 30px;

    font-weight: bold;

    color: #ff3b20;

    text-shadow:
        3px 3px 0 white,
        5px 5px 0 #222;

    z-index: 30;

    pointer-events: none;

    animation:
        comicPop 0.7s forwards;
}

@keyframes comicPop {

    0% {
        transform:
            scale(0.2)
            rotate(-10deg);

        opacity: 0;
    }

    50% {
        transform:
            scale(1.3)
            rotate(5deg);

        opacity: 1;
    }

    100% {
        transform:
            scale(1)
            translateY(-50px)
            rotate(-5deg);

        opacity: 0;
    }
}


/* =========================
   BUTTONS
========================= */

button {
    border: 4px solid #222;

    padding: 12px 28px;

    margin: 15px 5px;

    border-radius: 15px;

    font-family:
        "Comic Sans MS",
        Arial;

    font-size: 18px;

    font-weight: bold;

    cursor: pointer;

    background: #ffcf33;

    color: #222;

    box-shadow: 5px 5px 0 #222;

    transition: 0.1s;
}

button:hover {
    transform: translate(-2px, -2px);

    box-shadow: 7px 7px 0 #222;
}

button:active {
    transform: translate(3px, 3px);

    box-shadow: 2px 2px 0 #222;
}


/* =========================
   INSTRUCTIONS
========================= */

.instructions {
    margin-top: 8px;

    font-size: 17px;

    color: #333;

    line-height: 1.6;
}


/* =========================
   GAME OVER
========================= */

.game-over {
    display: none;

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            circle,
            #fff8a6,
            #ffdfdf
        );

    border-radius: 15px;

    border: 4px solid #222;

    z-index: 50;

    justify-content: center;

    align-items: center;

    flex-direction: column;
}

.game-over h2 {
    font-size: 48px;

    color: #ff4d32;

    text-shadow:
        4px 4px 0 #222;

    margin-bottom: 15px;
}

.game-over p {
    font-size: 22px;

    margin: 5px;
}

.final-score {
    font-size: 35px !important;

    font-weight: bold;

    color: #0879d1;
}


/* =========================
   MOBILE
========================= */

@media(max-width:600px) {

    h1 {
        font-size: 30px;
    }

    .game-area {
        height: 500px;
    }

    .info-bar {
        font-size: 16px;
    }

    .basket {
        width: 110px;
        height: 75px;
    }

    .basket .opening {
        width: 90px;
    }
}

</style>
</head>


<body>


<div class="game-container">


<h1>
    💨 CATCH THE AIR! 🧺
</h1>


<p class="subtitle">
    The world's most useless superhero game! 😂
</p>


<!-- SCORE + TIMER -->

<div class="info-bar">

    <div class="score">

        🏆 SCORE:

        <span id="score">
            0
        </span>

    </div>


    <div class="timer">

        ⏱️ TIME:

        <span id="timer">
            30
        </span>

        s

    </div>

</div>


<!-- GAME AREA -->

<div
    class="game-area"
    id="gameArea"
>


    <!-- CLOUDS -->

    <div class="cloud cloud1">
        ☁️
    </div>

    <div class="cloud cloud2">
        ☁️
    </div>


    <!-- BASKET -->

    <div
        class="basket"
        id="basket"
    >

        <!-- OPENING -->

        <div class="opening"></div>

        <!-- HANDLE -->

        <div class="handle"></div>

    </div>


    <!-- FUNNY IMAGE -->

    <div
        id="funnyImage"
        class="funny-image"
    >

        <img
            src="funny pic.jpg"
            alt="Funny picture"
        >

    </div>


    <!-- GAME OVER -->

    <div
        class="game-over"
        id="gameOver"
    >

        <h2>
            💥 BOOM! TIME'S UP!
        </h2>


        <p>
            The air escaped! 💨
        </p>


        <p>
            You caught absolutely
            nothing useful! 😂
        </p>


        <p class="final-score">

            🏆 Score:

            <span id="finalScore">
                0
            </span>

        </p>


        <button
            onclick="restartGame()"
        >
            🔄 PLAY AGAIN
        </button>

    </div>


</div>


<!-- BUTTONS -->

<button
    id="startButton"
    onclick="startGame()"
>

    ▶️ START GAME

</button>


<button
    onclick="restartGame()"
>

    🔄 RESTART

</button>


<!-- INSTRUCTIONS -->

<p class="instructions">

    🎮
    <b>
        ⬅️ ➡️ ⬆️ ⬇️
    </b>

    Move the basket.

    <br>

    💨 Let the air fall into the opening!

    <br>

    😂 The air isn't really stored!

</p>


</div>


<script>

/* =========================
   VARIABLES
========================= */

let score = 0;

let timeLeft = 30;

let gameRunning = false;

let timerInterval;

let airInterval;


/* BASKET POSITION */

let basketX = 400;

let basketY = 400;

const speed = 9;


/* ELEMENTS */

const gameArea =
    document.getElementById(
        "gameArea"
    );

const basket =
    document.getElementById(
        "basket"
    );

const scoreDisplay =
    document.getElementById(
        "score"
    );

const timerDisplay =
    document.getElementById(
        "timer"
    );

const gameOver =
    document.getElementById(
        "gameOver"
    );

const finalScore =
    document.getElementById(
        "finalScore"
    );

const startButton =
    document.getElementById(
        "startButton"
    );

const funnyImage =
    document.getElementById(
        "funnyImage"
    );


/* =========================
   START GAME
========================= */

function startGame() {

    if (gameRunning)
        return;


    /*
       SHOW FUNNY IMAGE
    */

    funnyImage.style.display =
        "flex";


    /*
       WAIT 2 SECONDS
       THEN START GAME
    */

    setTimeout(() => {

        funnyImage.style.display =
            "none";

        beginGame();

    }, 2000);

}


/* =========================
   ACTUAL GAME START
========================= */

function beginGame() {

    gameRunning = true;

    score = 0;

    timeLeft = 30;


    /*
       CENTER BASKET
    */

    basketX =
        (gameArea.clientWidth -
        basket.offsetWidth) / 2;


    basketY =
        gameArea.clientHeight -
        basket.offsetHeight -
        30;


    updateBasket();


    scoreDisplay.textContent =
        score;

    timerDisplay.textContent =
        timeLeft;


    gameOver.style.display =
        "none";


    startButton.textContent =
        "🎮 PLAYING...";


    /*
       TIMER
    */

    timerInterval =
        setInterval(() => {

            timeLeft--;

            timerDisplay.textContent =
                timeLeft;


            if (timeLeft <= 0) {

                endGame();

            }

        }, 1000);


    /*
       CREATE AIR
    */

    airInterval =
        setInterval(
            createAir,
            700
        );

}


/* =========================
   MOVE BASKET
========================= */

document.addEventListener(
    "keydown",
    function(event) {


    if (!gameRunning)
        return;


    const areaWidth =
        gameArea.clientWidth;

    const areaHeight =
        gameArea.clientHeight;


    const basketWidth =
        basket.offsetWidth;

    const basketHeight =
        basket.offsetHeight;


    /* LEFT */

    if (event.key === "ArrowLeft") {

        basketX -= speed;

    }


    /* RIGHT */

    if (event.key === "ArrowRight") {

        basketX += speed;

    }


    /* UP */

    if (event.key === "ArrowUp") {

        basketY -= speed;

    }


    /* DOWN */

    if (event.key === "ArrowDown") {

        basketY += speed;

    }


    /*
       KEEP BASKET INSIDE
    */

    basketX =
        Math.max(
            0,
            Math.min(
                basketX,
                areaWidth - basketWidth
            )
        );


    basketY =
        Math.max(
            80,
            Math.min(
                basketY,
                areaHeight -
                basketHeight -
                5
            )
        );


    updateBasket();

});


/* =========================
   UPDATE BASKET
========================= */

function updateBasket() {

    basket.style.left =
        basketX + "px";

    basket.style.top =
        basketY + "px";

}


/* =========================
   CREATE AIR
========================= */

function createAir() {

    if (!gameRunning)
        return;


    const air =
        document.createElement(
            "div"
        );


    air.className =
        "air";


    air.textContent =
        "💨";


    /*
       RANDOM X
    */

    let airX =
        Math.random() *
        (gameArea.clientWidth - 45);


    let airY = -50;


    air.style.left =
        airX + "px";

    air.style.top =
        airY + "px";


    gameArea.appendChild(
        air
    );


    /*
       FALLING SPEED
    */

    const fallSpeed =
        3 +
        Math.random() * 2;


    let caught = false;


    /* =========================
       AIR MOVEMENT
    ========================= */

    function moveAir() {


        if (!gameRunning) {

            air.remove();

            return;

        }


        airY += fallSpeed;

        air.style.top =
            airY + "px";


        /*
           AIR CENTER
        */

        const airCenterX =
            airX + 20;


        const airBottom =
            airY + 40;


        /*
           BASKET OPENING
        */

        const openingLeft =
            basketX + 15;


        const openingRight =
            basketX +
            basket.offsetWidth -
            15;


        const openingTop =
            basketY - 15;


        const openingBottom =
            basketY + 15;


        /*
           AIR ENTERS OPENING
        */

        if (

            !caught &&

            airCenterX >=
                openingLeft &&

            airCenterX <=
                openingRight &&

            airBottom >=
                openingTop &&

            airBottom <=
                openingBottom

        ) {


            caught = true;


            /*
               INCREASE SCORE
            */

            score++;

            scoreDisplay.textContent =
                score;


            /*
               COMIC MESSAGE
            */

            showComicText(
                basketX + 20,
                basketY - 50,
                "GOTCHA! 💥"
            );


            /*
               AIR IS NOT STORED

               It disappears after
               entering the basket.
            */

            air.style.transform =
                "scale(1.5)";

            air.style.opacity =
                "0";


            setTimeout(() => {

                if (air.parentElement) {

                    air.remove();

                }

            }, 150);


            return;

        }


        /*
           MISSED AIR
        */

        if (

            !caught &&

            airY >
                gameArea.clientHeight

        ) {

            air.remove();

            return;

        }


        requestAnimationFrame(
            moveAir
        );

    }


    requestAnimationFrame(
        moveAir
    );

}


/* =========================
   COMIC MESSAGE
========================= */

function showComicText(
    x,
    y,
    text
) {

    const comic =
        document.createElement(
            "div"
        );


    comic.className =
        "comic-text";


    comic.textContent =
        text;


    comic.style.left =
        x + "px";


    comic.style.top =
        y + "px";


    gameArea.appendChild(
        comic
    );


    setTimeout(() => {

        comic.remove();

    }, 700);

}


/* =========================
   END GAME
========================= */

function endGame() {

    gameRunning = false;


    clearInterval(
        timerInterval
    );


    clearInterval(
        airInterval
    );


    finalScore.textContent =
        score;


    gameOver.style.display =
        "flex";


    startButton.textContent =
        "▶️ START GAME";


    /*
       REMOVE AIR
    */

    document
        .querySelectorAll(".air")
        .forEach(
            air => air.remove()
        );

}


/* =========================
   RESTART
========================= */

function restartGame() {

    clearInterval(
        timerInterval
    );


    clearInterval(
        airInterval
    );


    gameRunning = false;


    score = 0;

    timeLeft = 30;


    basketX =
        (gameArea.clientWidth -
        basket.offsetWidth) / 2;


    basketY =
        gameArea.clientHeight -
        basket.offsetHeight -
        30;


    scoreDisplay.textContent =
        "0";


    timerDisplay.textContent =
        "30";


    updateBasket();


    gameOver.style.display =
        "none";


    funnyImage.style.display =
        "none";


    document
        .querySelectorAll(".air")
        .forEach(
            air => air.remove()
        );


    document
        .querySelectorAll(".comic-text")
        .forEach(
            text => text.remove()
        );


    startButton.textContent =
        "▶️ START GAME";

}

</script>

</body>
</html>